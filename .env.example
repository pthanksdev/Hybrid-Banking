# === Database (single Postgres, per-service schemas) ===
DATABASE_URL="postgresql://postgres:password@localhost:5432/hybrid_banking?schema=public"
LEDGER_DATABASE_URL="postgresql://postgres:password@localhost:5432/hybrid_banking?schema=ledger"
IDENTITY_DATABASE_URL="postgresql://postgres:password@localhost:5432/hybrid_banking?schema=identity"
BANKING_DATABASE_URL="postgresql://postgres:password@localhost:5432/hybrid_banking?schema=banking"
PAYMENTS_DATABASE_URL="postgresql://postgres:password@localhost:5432/hybrid_banking?schema=payments"
P2P_DATABASE_URL="postgresql://postgres:password@localhost:5432/hybrid_banking?schema=p2p"
WALLET_DATABASE_URL="postgresql://postgres:password@localhost:5432/hybrid_banking?schema=wallet"
BLOCKCHAIN_DATABASE_URL="postgresql://postgres:password@localhost:5432/hybrid_banking?schema=blockchain"
RISK_DATABASE_URL="postgresql://postgres:password@localhost:5432/hybrid_banking?schema=risk"
NOTIFICATIONS_DATABASE_URL="postgresql://postgres:password@localhost:5432/hybrid_banking?schema=notifications"

# === Service Ports ===
GATEWAY_PORT=3000
LEDGER_PORT=3001
IDENTITY_PORT=3002
BANKING_PORT=3003
PAYMENTS_PORT=3004
P2P_PORT=3005
WALLET_PORT=3006
BLOCKCHAIN_PORT=3007
DEFI_PORT=3008
MEMECOIN_PORT=3009
RISK_PORT=3010
NOTIFICATIONS_PORT=3011
COMPLIANCE_PORT=3012

# === Auth ===
JWT_SECRET="your-jwt-secret-change-in-production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# === Service URLs (for inter-service HTTP calls) ===
LEDGER_SERVICE_URL="http://localhost:3001"
IDENTITY_SERVICE_URL="http://localhost:3002"
BANKING_SERVICE_URL="http://localhost:3003"
PAYMENTS_SERVICE_URL="http://localhost:3004"
P2P_SERVICE_URL="http://localhost:3005"
WALLET_SERVICE_URL="http://localhost:3006"
BLOCKCHAIN_SERVICE_URL="http://localhost:3007"
RISK_SERVICE_URL="http://localhost:3010"
NOTIFICATIONS_SERVICE_URL="http://localhost:3011"
